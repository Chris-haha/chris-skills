FEISHU_APP_ID=cli_example
FEISHU_APP_SECRET=replace-with-app-secret
FEISHU_APP_TOKEN=app_token_example
FEISHU_TABLE_ID=tbl_example
FEISHU_BOT_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/replace-me
OUTPUT_DIR=./data
RETENTION_DAYS=7
AUTO_RUN_ENABLED=false
AUTO_RUN_INTERVAL_MINUTES=10
IMAGE_PROVIDER=mock
# Use IMAGE_PROVIDER=openai for real image generation.
# Direct OpenAI access only needs OPENAI_API_KEY.
# OpenAI-compatible gateways should also set OPENAI_BASE_URL and OPENAI_IMAGE_MODEL.
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://your-openai-compatible-gateway.example.com/v1
# OPENAI_IMAGE_MODEL=gpt-image-1
